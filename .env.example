# Copy to .env. Never commit .env.

# Port on your machine for the API (change if 8000 is taken).
NEWSWATCH_PORT=8000

# Identify yourself to publishers. Put a real contact address here.
NEWSWATCH_USER_AGENT=newswatch/0.1 (portfolio project; contact: you@example.com)
NEWSWATCH_MIN_FETCH_INTERVAL_S=600

# off | fake | anthropic
NEWSWATCH_LLM=off
NEWSWATCH_LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# USD per million tokens, from the provider's current pricing page. Used for cost reporting only.
NEWSWATCH_PRICE_IN_PER_MTOK=
NEWSWATCH_PRICE_OUT_PER_MTOK=
